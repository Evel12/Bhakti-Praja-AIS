APP_NAME="EXAMNIA API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
PASSWORD_RESET_URL=http://127.0.0.1:4173/#/reset-password
API_TOKEN_EXPIRATION=120
TRUSTED_PROXIES=
API_HSTS_MAX_AGE=0
API_RATE_PER_MINUTE=120
API_TEACHER_WRITES_PER_MINUTE=30
API_ATTEMPT_STARTS_PER_MINUTE=10
API_REPORTS_PER_MINUTE=30
API_GENERATION_PER_MINUTE=3
API_GENERATION_PER_HOUR=20

QUIZ_BASE_POINTS=10.00
QUIZ_STREAK_MULTIPLIER_STEP=0.10
QUIZ_MULTIPLIER_CAP=2.00
QUIZ_WRONG_ANSWER_RESETS_STREAK=true
QUIZ_FINAL_GRADE_FORMULA=percentage_correct

# Reference Python adapter; configure after agreeing the contract with the AI developer.
AI_SERVICE_BASE_URL=
AI_SERVICE_QUIZ_ENDPOINT=/generate-quiz
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT=60
AI_SERVICE_CONNECT_TIMEOUT=10
AI_MODULE_DISK=local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=examnia
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_LIMITER=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
